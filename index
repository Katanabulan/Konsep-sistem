<!DOCTYPE html>
<html lang="id" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Parkir IoT Knowledge Base - Panduan Konsep & Sistem Ketua Tim</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --brand-primary: #1e40af;
            --brand-secondary: #0ea5e9;
            --brand-accent: #f59e0b;
            --brand-dark: #0f172a;
            --brand-surface: #ffffff;
            --brand-bg: #f8fafc;
            --border-color: #e2e8f0;
        }

        [data-bs-theme="dark"] {
            --brand-surface: #1e293b;
            --brand-bg: #0b1120;
            --border-color: #334155;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--brand-bg);
            color: var(--bs-body-color);
            line-height: 1.6;
        }

        .font-mono {
            font-family: 'JetBrains Mono', monospace;
        }

        /* Hero Header */
        .hero-banner {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #0369a1 100%);
            color: white;
            border-bottom: 3px solid #38bdf8;
        }

        /* Navigation Pills */
        .nav-custom {
            background: var(--brand-surface);
            border-radius: 1rem;
            padding: 0.5rem;
            border: 1px solid var(--border-color);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }
        .nav-custom .nav-link {
            color: #64748b;
            font-weight: 600;
            border-radius: 0.75rem;
            padding: 0.65rem 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.2s ease;
        }
        .nav-custom .nav-link:hover {
            color: var(--brand-primary);
            background: rgba(30, 64, 175, 0.08);
        }
        .nav-custom .nav-link.active {
            background: var(--brand-primary);
            color: white !important;
            box-shadow: 0 4px 12px rgba(30, 64, 175, 0.35);
        }

        /* Cards */
        .custom-card {
            background: var(--brand-surface);
            border: 1px solid var(--border-color);
            border-radius: 1rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .custom-card:hover {
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
        }

        /* Architecture Nodes */
        .arch-node {
            border-radius: 0.85rem;
            padding: 1.25rem;
            border: 1px solid var(--border-color);
            background: var(--brand-surface);
            position: relative;
        }
        .arch-badge {
            font-size: 0.7rem;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            font-weight: 800;
        }

        /* Flow Step */
        .flow-step {
            position: relative;
            padding-left: 2.2rem;
            margin-bottom: 1.5rem;
        }
        .flow-step::before {
            content: '';
            position: absolute;
            left: 0.75rem;
            top: 2rem;
            bottom: -1rem;
            width: 2px;
            background: #cbd5e1;
        }
        .flow-step:last-child::before {
            display: none;
        }
        .step-num {
            position: absolute;
            left: 0;
            top: 0;
            width: 1.75rem;
            height: 1.75rem;
            border-radius: 50%;
            background: var(--brand-primary);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.85rem;
        }

        /* Interactive QA accordion */
        .qa-card {
            cursor: pointer;
            border-left: 4px solid var(--brand-secondary) !important;
        }
        .qa-answer {
            display: none;
        }
        .qa-card.open .qa-answer {
            display: block;
        }
        .qa-card.open .qa-icon {
            transform: rotate(180deg);
        }

        /* Pin Badge */
        .badge-pin {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.85rem;
            padding: 0.35rem 0.6rem;
            border-radius: 0.4rem;
        }

        /* Code block */
        pre code {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.82rem;
        }

        @media print {
            .no-print, .nav-custom, #searchBox, .theme-toggle {
                display: none !important;
            }
            .tab-pane {
                display: block !important;
                opacity: 1 !important;
                visibility: visible !important;
                page-break-after: always;
            }
            body {
                background: white !important;
                color: black !important;
            }
            .custom-card {
                box-shadow: none !important;
                border: 1px solid #ccc !important;
            }
            .qa-answer {
                display: block !important;
            }
        }
    </style>
</head>
<body>

    <!-- HERO HEADER -->
    <header class="hero-banner py-4 px-3 px-md-5 mb-4 shadow-sm">
        <div class="container-fluid max-w-7xl">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-warning text-dark fw-bold px-2.5 py-1.5 rounded-pill font-mono">
                            <i class="bi bi-mortarboard-fill me-1"></i>TEAM LEAD BRIEFING
                        </span>
                        <span class="badge bg-white bg-opacity-20 text-white border border-white border-opacity-25 px-2.5 py-1.5 rounded-pill">
                            Sigma Boys &bull; E-Parkir Industrial IoT
                        </span>
                    </div>
                    <h2 class="fw-extrabold mb-1 tracking-tight">Portal Pembelajaran & Konsep Sistem E-Parkir IoT</h2>
                    <p class="mb-0 text-white-50 small">
                        Panduan komprehensif konsep sistem, alur IoT end-to-end, bedah kode firmware ESP8266, integrasi printer POS-58, serta strategi tanya-jawab sidang.
                    </p>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap no-print">
                    <button class="btn btn-outline-light btn-sm rounded-pill px-3 d-flex align-items-center gap-1.5" onclick="window.print()">
                        <i class="bi bi-printer"></i>
                        <span>Cetak Panduan / PDF</span>
                    </button>
                    <button class="btn btn-light btn-sm rounded-pill px-3 fw-bold text-dark d-flex align-items-center gap-1.5 shadow-sm" onclick="toggleDarkMode()">
                        <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                        <span id="themeText">Mode Gelap</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="container-fluid max-w-7xl px-3 px-md-5 pb-5">

        <!-- STICKY NAVIGATION TABS -->
        <nav class="nav-custom mb-4 sticky-top no-print d-flex flex-wrap gap-1" style="top: 15px; z-index: 1020;">
            <ul class="nav nav-pills w-100 flex-column flex-md-row" id="pills-tab" role="tablist">
                <li class="nav-item flex-fill" role="presentation">
                    <button class="nav-link w-100 active" id="tab-lead-btn" data-bs-toggle="pill" data-bs-target="#tab-lead" type="button" role="tab">
                        <i class="bi bi-award-fill text-warning"></i>
                        <span>1. Peran Ketua & Big Picture</span>
                    </button>
                </li>
                <li class="nav-item flex-fill" role="presentation">
                    <button class="nav-link w-100" id="tab-hardware-btn" data-bs-toggle="pill" data-bs-target="#tab-hardware" type="button" role="tab">
                        <i class="bi bi-cpu-fill text-info"></i>
                        <span>2. Hardware & Pinout</span>
                    </button>
                </li>
                <li class="nav-item flex-fill" role="presentation">
                    <button class="nav-link w-100" id="tab-firmware-btn" data-bs-toggle="pill" data-bs-target="#tab-firmware" type="button" role="tab">
                        <i class="bi bi-code-slash text-success"></i>
                        <span>3. Bedah Kode ESP8266</span>
                    </button>
                </li>
                <li class="nav-item flex-fill" role="presentation">
                    <button class="nav-link w-100" id="tab-rest-btn" data-bs-toggle="pill" data-bs-target="#tab-rest" type="button" role="tab">
                        <i class="bi bi-arrow-left-right text-primary"></i>
                        <span>4. REST API & Printer</span>
                    </button>
                </li>
                <li class="nav-item flex-fill" role="presentation">
                    <button class="nav-link w-100" id="tab-qa-btn" data-bs-toggle="pill" data-bs-target="#tab-qa" type="button" role="tab">
                        <i class="bi bi-question-diamond-fill text-danger"></i>
                        <span>5. Tanya-Jawab Sidang Dosen</span>
                    </button>
                </li>
                <li class="nav-item flex-fill" role="presentation">
                    <button class="nav-link w-100" id="tab-cheat-btn" data-bs-toggle="pill" data-bs-target="#tab-cheat" type="button" role="tab">
                        <i class="bi bi-lightning-charge-fill text-warning"></i>
                        <span>6. Cheatsheet 5 Menit</span>
                    </button>
                </li>
            </ul>
        </nav>

        <!-- TAB CONTENT CONTAINER -->
        <div class="tab-content" id="pills-tabContent">

            <!-- ============================================================= -->
            <!-- TAB 1: PERAN KETUA & BIG PICTURE ARCHITECTURE -->
            <!-- ============================================================= -->
            <div class="tab-pane fade show active" id="tab-lead" role="tabpanel">
                
                <!-- Introduction Banner -->
                <div class="custom-card p-4 mb-4 border-start border-4 border-warning">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-4 fs-3">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-1">Pedoman Utama Sebagai Ketua Tim (Team Lead)</h4>
                            <p class="text-muted small mb-0">
                                Dosen penguji dan audiens tidak mengharapkan Anda menghafal titik-koma program, melainkan menuntut Anda menguasai <strong>alasan teknis pemilihan teknologi (*Design Decisions*)</strong>, <strong>alur perpindahan data (*Data Flow*)</strong>, dan <strong>keamanan sistem saat terjadi kendala (*Fault Tolerance*)</strong>.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- 3-TIER ARCHITECTURE CARD -->
                <div class="custom-card p-4 mb-4">
                    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                        <h5 class="fw-bold mb-0 text-primary d-flex align-items-center gap-2">
                            <i class="bi bi-layers-half"></i>
                            <span>Arsitektur 3 Lapisan (End-to-End System Architecture)</span>
                        </h5>
                        <span class="badge bg-primary-subtle text-primary border">Konsep Desain</span>
                    </div>

                    <div class="row g-3">
                        <!-- Layer 1 -->
                        <div class="col-12 col-lg-4">
                            <div class="arch-node h-100 border-primary border-opacity-50">
                                <span class="badge bg-primary arch-badge mb-2">Lapisan 1 &bull; Edge Hardware</span>
                                <h6 class="fw-bold text-dark mt-1">NodeMCU ESP8266 & Periferal</h6>
                                <p class="text-muted small mb-2">Fokus pada akuisisi data sensor dan kontrol aktuator fisik di gerbang secara instan.</p>
                                <ul class="small ps-3 text-secondary mb-0">
                                    <li>MFRC522: Pembaca kartu RFID (SPI)</li>
                                    <li>Dual Servo SG90: Palang masuk & keluar</li>
                                    <li>LED 1-Pin Dual Color: Merah & Hijau</li>
                                    <li>Buzzer Audio: Indikator akustik</li>
                                    <li>Push Button: Permintaan tiket masuk fisik</li>
                                </ul>
                            </div>
                        </div>
                        <!-- Layer 2 -->
                        <div class="col-12 col-lg-4">
                            <div class="arch-node h-100 border-info border-opacity-50">
                                <span class="badge bg-info text-dark arch-badge mb-2">Lapisan 2 &bull; Jaringan & Transport</span>
                                <h6 class="fw-bold text-dark mt-1">Wi-Fi Router & REST Protocol</h6>
                                <p class="text-muted small mb-2">Penghubung data nirkabel kecepatan tinggi tanpa beban server perantara broker.</p>
                                <ul class="small ps-3 text-secondary mb-0">
                                    <li>SSID Router: <code class="text-primary font-mono">Day One</code></li>
                                    <li>Protokol: HTTP 1.1 REST API (JSON payload)</li>
                                    <li>Direct API (0ms latency dari browser ke ESP)</li>
                                    <li>Auto Reconnect jika sinyal router drop</li>
                                </ul>
                            </div>
                        </div>
                        <!-- Layer 3 -->
                        <div class="col-12 col-lg-4">
                            <div class="arch-node h-100 border-success border-opacity-50">
                                <span class="badge bg-success arch-badge mb-2">Lapisan 3 &bull; Otak & Database</span>
                                <h6 class="fw-bold text-dark mt-1">Laravel 11 & Printer Thermal</h6>
                                <p class="text-muted small mb-2">Pengelola seluruh logika bisnis, kalkulasi tarif parkir, dan audit database.</p>
                                <ul class="small ps-3 text-secondary mb-0">
                                    <li>Database MySQL: User, Kartu, Log, Slot</li>
                                    <li>Perhitungan tarif jam pro-rata</li>
                                    <li>Web Admin & Pos Kasir Live Sync</li>
                                    <li>Printer POS-58 USB Direct RAW byte stream</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2 OPERATIONAL USE CASES -->
                <div class="row g-4 mb-4">
                    <!-- Flow 1: Member RFID -->
                    <div class="col-12 col-lg-6">
                        <div class="custom-card p-4 h-100">
                            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                <h6 class="fw-bold mb-0 text-success d-flex align-items-center gap-2">
                                    <i class="bi bi-credit-card-2-front-fill"></i>
                                    <span>Alur A: Member Langganan (Kartu RFID)</span>
                                </h6>
                                <span class="badge bg-success-subtle text-success">Cashless</span>
                            </div>

                            <div class="flow-step">
                                <div class="step-num">1</div>
                                <h6 class="fw-bold small mb-1">Tap Masuk (Gate IN)</h6>
                                <p class="text-muted small mb-0">Pengendara menempelkan kartu ke sensor RC522. ESP membaca UID Hex dan mengirim request HTTP POST ke Laravel.</p>
                            </div>
                            <div class="flow-step">
                                <div class="step-num">2</div>
                                <h6 class="fw-bold small mb-1">Validasi Otomatis Server</h6>
                                <p class="text-muted small mb-0">Laravel mengecek status member & ketersediaan slot. Jika valid, slot berkurang 1, palang masuk terbuka 8 detik, lampu hijau menyala.</p>
                            </div>
                            <div class="flow-step">
                                <div class="step-num">3</div>
                                <h6 class="fw-bold small mb-1">Tap Keluar (Gate OUT) & Potong Saldo</h6>
                                <p class="text-muted small mb-0">Pengendara men-tap di gate keluar. Durasi parkir dihitung (misal: 85 menit = 2 jam x Rp 2.000 = Rp 4.000). Saldo kartu langsung terpotong di database.</p>
                            </div>
                            <div class="flow-step">
                                <div class="step-num">4</div>
                                <h6 class="fw-bold small mb-1">Cetak Bukti Transaksi Lunas</h6>
                                <p class="text-muted small mb-0">Palang keluar membuka, buzzer bip 2x, dan printer kasir otomatis mencetak struk bukti pembayaran 28 kolom.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Flow 2: Tamu Karcis -->
                    <div class="col-12 col-lg-6">
                        <div class="custom-card p-4 h-100">
                            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                <h6 class="fw-bold mb-0 text-warning d-flex align-items-center gap-2">
                                    <i class="bi bi-ticket-perforated-fill"></i>
                                    <span>Alur B: Pengendara Umum (Karcis Barcode)</span>
                                </h6>
                                <span class="badge bg-warning-subtle text-warning">Karcis Tunai</span>
                            </div>

                            <div class="flow-step">
                                <div class="step-num">1</div>
                                <h6 class="fw-bold small mb-1">Tekan Tombol Karcis Masuk</h6>
                                <p class="text-muted small mb-0">Pengendara tanpa kartu menekan tombol merah pada tiang gerbang masuk (Pin TX/GPIO1).</p>
                            </div>
                            <div class="flow-step">
                                <div class="step-num">2</div>
                                <h6 class="fw-bold small mb-1">Cetak Karcis & Palang Membuka</h6>
                                <p class="text-muted small mb-0">ESP menembak <code class="font-mono">/api/ticket</code> ke Laravel. Server membuat kode tiket unik (misal: <code class="font-mono">TKT-261117-0028</code>) dan printer otomatis mengeluarkan karcis. Palang terbuka 10 detik.</p>
                            </div>
                            <div class="flow-step">
                                <div class="step-num">3</div>
                                <h6 class="fw-bold small mb-1">Penyerahan Karcis di Pos Kasir</h6>
                                <p class="text-muted small mb-0">Saat keluar, pengendara menyerahkan karcis ke kasir. Petugas men-scan barcode atau klik tombol selesaikan di web monitoring pos kasir.</p>
                            </div>
                            <div class="flow-step">
                                <div class="step-num">4</div>
                                <h6 class="fw-bold small mb-1">Bayar Tunai & Buka Palang</h6>
                                <p class="text-muted small mb-0">Setelah menerima uang tunai, petugas mengonfirmasi di sistem. Palang keluar terangkat otomatis dan struk pembayaran tercetak.</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ============================================================= -->
            <!-- TAB 2: HARDWARE & PINOUT MAPPING -->
            <!-- ============================================================= -->
            <div class="tab-pane fade" id="tab-hardware" role="tabpanel">
                
                <div class="custom-card p-4 mb-4">
                    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                        <h5 class="fw-bold mb-0 text-primary d-flex align-items-center gap-2">
                            <i class="bi bi-diagram-3-fill"></i>
                            <span>Tabel Pemetaan Pin Hardware (Pinout NodeMCU V3)</span>
                        </h5>
                        <span class="badge bg-secondary-subtle text-secondary font-mono">ESP-12E Board</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle border">
                            <thead class="table-light font-mono small">
                                <tr>
                                    <th>Pin Board</th>
                                    <th>GPIO ESP</th>
                                    <th>Komponen Hardware</th>
                                    <th>Jalur Komunikasi</th>
                                    <th>Penjelasan Teknis & Catatan Penguji</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                <tr>
                                    <td><span class="badge bg-primary font-mono badge-pin">D8</span></td>
                                    <td><code>GPIO15</code></td>
                                    <td><strong>RFID SDA (SS)</strong></td>
                                    <td><span class="badge bg-info-subtle text-info border">SPI Slave Select</span></td>
                                    <td>Wajib pull-down saat booting ESP8266 agar mode flash normal tidak terganggu.</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-primary font-mono badge-pin">D5</span></td>
                                    <td><code>GPIO14</code></td>
                                    <td><strong>RFID SCK</strong></td>
                                    <td><span class="badge bg-info-subtle text-info border">SPI Clock</span></td>
                                    <td>Jalur detak sinkronisasi pengiriman data byte kartu.</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-primary font-mono badge-pin">D7</span></td>
                                    <td><code>GPIO13</code></td>
                                    <td><strong>RFID MOSI</strong></td>
                                    <td><span class="badge bg-info-subtle text-info border">SPI Data In</span></td>
                                    <td>Master-Out-Slave-In (ESP mengirim perintah konfigurasi ke RC522).</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-primary font-mono badge-pin">D6</span></td>
                                    <td><code>GPIO12</code></td>
                                    <td><strong>RFID MISO</strong></td>
                                    <td><span class="badge bg-info-subtle text-info border">SPI Data Out</span></td>
                                    <td>Master-In-Slave-Out (RC522 mengirim data UID kartu ke ESP).</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-primary font-mono badge-pin">D0</span></td>
                                    <td><code>GPIO16</code></td>
                                    <td><strong>RFID RST</strong></td>
                                    <td><span class="badge bg-secondary-subtle text-secondary border">Reset Line</span></td>
                                    <td>Pin reset modul RC522 untuk proses auto-recovery jika sensor crash.</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-success font-mono badge-pin">D1</span></td>
                                    <td><code>GPIO5</code></td>
                                    <td><strong>LED Gerbang Masuk</strong></td>
                                    <td><span class="badge bg-warning-subtle text-warning border">Dual Polaritas</span></td>
                                    <td>1 Pin 2 Warna: <code>LOW</code> = Merah (Tutup), <code>HIGH</code> = Hijau (Buka).</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-success font-mono badge-pin">D2</span></td>
                                    <td><code>GPIO4</code></td>
                                    <td><strong>LED Gerbang Keluar</strong></td>
                                    <td><span class="badge bg-warning-subtle text-warning border">Dual Polaritas</span></td>
                                    <td>1 Pin 2 Warna: <code>LOW</code> = Merah (Tutup), <code>HIGH</code> = Hijau (Buka).</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-warning text-dark font-mono badge-pin">D3</span></td>
                                    <td><code>GPIO0</code></td>
                                    <td><strong>Servo Palang Masuk</strong></td>
                                    <td><span class="badge bg-danger-subtle text-danger border">PWM Signal</span></td>
                                    <td>0° = Tutup mendatar, 90° = Terbuka tegak lurus (SG90 TowerPro).</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-warning text-dark font-mono badge-pin">D4</span></td>
                                    <td><code>GPIO2</code></td>
                                    <td><strong>Servo Palang Keluar</strong></td>
                                    <td><span class="badge bg-danger-subtle text-danger border">PWM Signal</span></td>
                                    <td>0° = Tutup mendatar, 90° = Terbuka tegak lurus (SG90 TowerPro).</td>
                                </tr>
                                <tr>
